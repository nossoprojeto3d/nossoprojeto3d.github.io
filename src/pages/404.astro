---
import Pagina from "../layouts/Pagina.astro";
import { LINKS, url } from "../data/links";
---
<Pagina titulo="Página não encontrada · Nosso Projeto 3D" descricao="A página que você procurou não existe ou mudou de lugar." semIndice>
  <!-- Endereços que mudaram de lugar: leva para o novo mantendo o resto do link (?…, #…).
       O GitHub Pages serve este 404 em qualquer caminho que não exista no domínio. -->
  <script is:inline>
    (function () {
      var mudou = { "/calc-3d": "/calculadora", "/ajuste-3mf": "/ajustes", "/site": "" };
      var p = location.pathname;
      for (var antigo in mudou) {
        if (p === antigo || p.indexOf(antigo + "/") === 0) {
          location.replace(((mudou[antigo] + p.slice(antigo.length)) || "/") + location.search + location.hash);
          return;
        }
      }
    })();
  </script>
  <section class="erro">
    <div class="container">
      <span class="etiqueta">Erro 404</span>
      <h1>Essa peça <span>não saiu da impressora.</span></h1>
      <p>A página que você procurou não existe ou mudou de lugar. O resto do site está inteiro.</p>
      <div class="botoes">
        <a href={url()} class="botao botao-ouro">Voltar ao início <span class="ilha"><svg width="18" height="18" aria-hidden="true"><use href="#i-right"/></svg></span></a>
        <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer" class="botao botao-claro">Ver catálogo <span class="ilha"><svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></span></a>
      </div>
    </div>
  </section>
</Pagina>

<style>
  .erro{padding:180px 0 140px;text-align:center;}
  h1{margin:24px auto 0;font-size:var(--fs-h2);line-height:1.02;max-width:14ch;}
  h1 span{background:linear-gradient(180deg,#F3DC8E,#C9A227 60%,#9C7A1C);-webkit-background-clip:text;background-clip:text;color:transparent;}
  p{margin:24px auto 0;max-width:42ch;font-size:var(--fs-lead);line-height:1.6;color:var(--body);}
  .botoes{margin-top:40px;display:flex;flex-wrap:wrap;justify-content:center;gap:12px;}
  @media (max-width:560px){ .erro{padding:130px 0 96px;} .botoes .botao{width:100%;} }
</style>
