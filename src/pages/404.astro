---
import Pagina from "../layouts/Pagina.astro";
import { LINKS, url } from "../data/links";
---
<Pagina titulo="Página não encontrada · Nosso Projeto 3D" descricao="A página que você procurou não existe ou mudou de lugar." semIndice>
  <!-- Endereços que mudaram de lugar: leva para o novo mantendo o resto do link (?…, #…).
       O GitHub Pages serve este 404 em qualquer caminho que não exista no domínio. -->
  <script is:inline>
    (function () {
      var mudou = { "/calc-3d": "/calculadora", "/ajuste-3mf": "/fatio", "/ajustes": "/fatio", "/site": "" };
      var p = location.pathname;
      for (var antigo in mudou) {
        if (p === antigo || p.indexOf(antigo + "/") === 0) {
          location.replace(((mudou[antigo] + p.slice(antigo.length)) || "/") + location.search + location.hash);
          return;
        }
      }
    })();
  </script>
  <section class="erro">
    <div class="container">
      <span class="etiqueta">Erro 404</span>
      <h1>Essa peça <span class="destaque">não saiu da impressora.</span></h1>
      <p>A página que você procurou não existe ou mudou de lugar. O resto do site está inteiro.</p>
      <div class="botoes">
        <a href={url()} class="botao botao-ouro">Voltar ao início <svg width="18" height="18" aria-hidden="true"><use href="#i-right"/></svg></a>
        <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer" class="botao botao-claro">Ver catálogo <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>
</Pagina>

<style>
  .erro{padding:clamp(72px,10vw,140px) 0;text-align:center;}
  h1{margin:16px auto 0;font-size:var(--fs-h2);font-weight:800;line-height:1.05;max-width:16ch;}
  p{margin:20px auto 0;max-width:42ch;font-size:var(--fs-lead);line-height:1.6;color:var(--body);}
  .botoes{margin-top:32px;display:flex;flex-wrap:wrap;justify-content:center;gap:12px;}
  @media (max-width:560px){ .botoes .botao{width:100%;} }
</style>
