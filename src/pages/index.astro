---
// Página única da V4, de cima pra baixo: três portas (Quero comprar, Sou maker, Quem somos),
// "Criamos suas ideias" com os queridinhos do catálogo sorteados a cada visita, ferramentas para criadores e Quem somos.
import { readFile } from "node:fs/promises";
import Pagina from "../layouts/Pagina.astro";
import Historia from "../components/v4/Historia.astro";
import { LINKS, QUERIDINHOS_JSON, url, whatsapp } from "../data/links";

interface Queridinho { codigo: string; nome: string; preco: string; foto: string; link: string }

// Lista do build do catálogo. Entra no HTML como ponto de partida (funciona sem JS e no Google);
// no navegador, o script busca a lista atual e sorteia. QUERIDINHOS_ARQUIVO serve para testar com um arquivo local.
let queridinhos: Queridinho[] = [];
try {
  const local = process.env.QUERIDINHOS_ARQUIVO;
  queridinhos = local ? JSON.parse(await readFile(local, "utf8")) : await (await fetch(QUERIDINHOS_JSON)).json();
  if (!Array.isArray(queridinhos)) queridinhos = [];
} catch {
  queridinhos = [];
}
const BASE_CATALOGO = LINKS.catalogo.site;
const foto = (q: Queridinho) => (/^https?:/.test(q.foto) ? q.foto : BASE_CATALOGO + q.foto);
const iniciais = queridinhos.slice(0, 6);

const ferramentas = [
  { nome: "Calculadora", texto: "Descubra quanto cobrar pela sua peça: material, energia, tempo e lucro.", href: LINKS.calculadora.site, link: "calculadora.site", icone: "i-calc", imagem: "assets/projetos/calculadora.jpg" },
  { nome: "Ajuste 3MF", texto: "Envie o projeto do Bambu Studio e a IA sugere as configurações.", href: LINKS.ajuste3mf.site, link: "ajuste3mf.site", icone: "i-sliders", imagem: "assets/projetos/ajustes.jpg" },
  { nome: "Dicas", texto: "As dicas de impressão dos nossos vídeos, organizadas por número.", href: LINKS.dicas.site, link: "dicas.site", icone: "i-bulb", imagem: "assets/projetos/dicas.jpg" },
  { nome: "STLs grátis", texto: "Arquivos prontos para você baixar e imprimir em casa.", href: LINKS.hub.stlsGratis, link: "hub.stlsGratis", icone: "i-cube", imagem: "" }
];
---
<Pagina titulo="Nosso Projeto 3D · Impressão 3D em Goiânia" descricao="Peças personalizadas impressas em 3D em Goiânia e ferramentas gratuitas para quem imprime: calculadora, ajuste de 3MF, STLs e dicas.">

  <!-- ===== Abertura e as três portas ===== -->
  <section class="abertura pontos">
    <div class="container">
      <h1>Ideias que ganham forma, <span class="destaque">camada por camada.</span></h1>
      <p class="abertura-apoio">Impressão 3D em Goiânia. Escolha por onde começar:</p>
      <div class="portas">
        <a class="porta porta-vitrine" href="#comprar" data-porta="comprar">
          <div class="porta-arte" aria-hidden="true">
            <div class="janela" data-giro="pecas">
              {iniciais.slice(0, 4).map((q, i) => (
                <figure class:list={["quadro", { ativo: i === 0 }]}><img src={foto(q)} alt="" width="480" height="480" loading={i ? "lazy" : "eager"} decoding="async"></figure>
              ))}
            </div>
          </div>
          <div class="porta-texto">
            <span class="etiqueta">Para você</span>
            <strong>Quero comprar</strong>
            <span class="porta-sub">Peças personalizadas, catálogo e WhatsApp</span>
          </div>
          <span class="porta-seta" aria-hidden="true"><svg width="18" height="18"><use href="#i-down"/></svg></span>
        </a>

        <a class="porta porta-vitrine" href="#criadores" data-porta="criadores">
          <div class="porta-arte" aria-hidden="true">
            <div class="janela janela-tela" data-giro="projetos">
              {ferramentas.map((f, i) => (
                <figure class:list={["quadro", { ativo: i === 0 }]}>
                  <span class="barra"><i></i><i></i><i></i><b>{f.nome}</b></span>
                  {f.imagem ? <img src={url(f.imagem)} alt="" width="960" height="713" loading={i ? "lazy" : "eager"} decoding="async"> : <span class="stl">STLs<br>grátis</span>}
                </figure>
              ))}
            </div>
          </div>
          <div class="porta-texto">
            <span class="etiqueta">Para criadores</span>
            <strong>Sou maker</strong>
            <span class="porta-sub">Calculadora, Ajuste 3MF, STLs e dicas</span>
          </div>
          <span class="porta-seta" aria-hidden="true"><svg width="18" height="18"><use href="#i-down"/></svg></span>
        </a>

        <a class="porta porta-foto" href="#quem-somos" data-porta="quem-somos">
          <img class="porta-fundo" src={url("assets/fotos/01-casal.jpg")} alt="" width="1080" height="1350" decoding="async">
          <div class="porta-texto">
            <span class="etiqueta">Nossa história</span>
            <strong>Quem somos</strong>
            <span class="porta-sub"><svg width="14" height="14" aria-hidden="true"><use href="#i-pin"/></svg> Goiânia · GO</span>
          </div>
          <span class="porta-seta" aria-hidden="true"><svg width="18" height="18"><use href="#i-down"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Para você: queridinhos do catálogo ===== -->
  <section class="secao" id="comprar" aria-labelledby="comprar-titulo">
    <div class="container">
      <div class="secao-topo surge">
        <div>
          <span class="etiqueta">Para você</span>
          <h2 id="comprar-titulo">Criamos suas ideias camada por camada</h2>
          <p class="apoio">Peças personalizadas com nome, cor e detalhe do seu jeito. Estes são os queridinhos do nosso catálogo.</p>
        </div>
        <div class="acoes">
          <a class="botao botao-zap" href={whatsapp("comprar")} data-link="whatsapp.comprar" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" aria-hidden="true"><use href="#i-whatsapp"/></svg> Pedir no WhatsApp</a>
          <a class="botao botao-ouro" href={BASE_CATALOGO} data-link="catalogo.site" target="_blank" rel="noopener noreferrer">Ver catálogo completo <svg width="18" height="18" aria-hidden="true"><use href="#i-right"/></svg></a>
        </div>
      </div>
      <ul class="pecas surge" data-pecas data-fonte={QUERIDINHOS_JSON} data-base={BASE_CATALOGO}>
        {iniciais.map((q) => (
          <li><a class="peca" href={BASE_CATALOGO + q.link} data-link="catalogo.peca" data-produto={q.codigo} target="_blank" rel="noopener noreferrer">
            <img src={foto(q)} alt={q.nome} width="480" height="480" loading="lazy" decoding="async">
            <span class="peca-nome">{q.nome}</span>
            <span class="peca-preco">R$ {q.preco}</span>
          </a></li>
        ))}
      </ul>
      <script type="application/json" id="queridinhos-iniciais" set:html={JSON.stringify(queridinhos)} />
      <p class="tambem surge">Prefere comprar por uma plataforma? <a href={LINKS.hub.shopee} data-link="hub.shopee" target="_blank" rel="noopener noreferrer">Estamos também na Shopee</a>.</p>
    </div>
  </section>

  <!-- ===== Para criadores ===== -->
  <section class="secao" id="criadores" aria-labelledby="criadores-titulo">
    <div class="container">
      <div class="surge">
        <span class="etiqueta">Para criadores</span>
        <h2 id="criadores-titulo">Ferramentas gratuitas para quem imprime</h2>
        <p class="apoio">Feitas por nós para o dia a dia da nossa bancada, abertas para qualquer maker usar.</p>
      </div>
      <ul class="ferramentas">
        {ferramentas.map((f) => (
          <li class="surge"><a class="ferramenta" href={f.href} data-link={f.link} target="_blank" rel="noopener noreferrer">
            <span class="ferramenta-tela">
              {f.imagem ? <img src={url(f.imagem)} alt={`Tela do ${f.nome}`} width="960" height="713" loading="lazy" decoding="async"> : <span class="stl">STLs<br>grátis</span>}
            </span>
            <span class="ferramenta-corpo">
              <span class="ferramenta-icone"><svg width="20" height="20" aria-hidden="true"><use href={`#${f.icone}`}/></svg></span>
              <strong>{f.nome}</strong>
              <span>{f.texto}</span>
            </span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Quem somos ===== -->
  <section class="secao" id="quem-somos" aria-labelledby="quem-titulo">
    <div class="container quem">
      <div class="quem-foto surge">
        <img src={url("assets/fotos/01-casal.jpg")} alt="Ilustração de Júnior e Thairine no escritório, com um modelo 3D na tela do computador" width="1080" height="1350" loading="lazy" decoding="async">
      </div>
      <div class="quem-texto surge">
        <span class="etiqueta">Quem somos</span>
        <h2 id="quem-titulo">Um casal construindo junto, com propósito e fé.</h2>
        <p class="apoio">Júnior é engenheiro de software e Thairine é arquiteta. Cada peça passa pelas nossas mãos, do projeto ao acabamento.</p>
        <figure class="verso">
          <blockquote>“Confia ao Senhor as tuas obras, e os teus desígnios serão estabelecidos.”</blockquote>
          <figcaption>Provérbios 16:3</figcaption>
        </figure>
        <div class="onde">
          <span class="onde-pino"><svg width="20" height="20" aria-hidden="true"><use href="#i-pin"/></svg></span>
          <span><strong>Goiânia · GO</strong><br>Enviamos para todo o Brasil.</span>
        </div>
        <div class="acoes">
          <button type="button" class="botao botao-claro" data-abre="historia">Conheça nossa história <svg width="18" height="18" aria-hidden="true"><use href="#i-right"/></svg></button>
          <a class="botao botao-claro" href={LINKS.contato.instagram} data-link="contato.instagram" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" aria-hidden="true"><use href="#i-instagram"/></svg> Instagram</a>
          <a class="botao botao-zap" href={whatsapp("quemSomos")} data-link="whatsapp.quemSomos" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" aria-hidden="true"><use href="#i-whatsapp"/></svg> WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <Historia />
</Pagina>

<style>
  /* ---------- abertura ---------- */
  .abertura{padding:clamp(28px,4vw,56px) 0 clamp(36px,5vw,64px);}
  h1{font-size:var(--fs-h1);font-weight:800;line-height:1.02;max-width:20ch;}
  .abertura-apoio{margin-top:14px;color:var(--body);font-size:var(--fs-lead);}

  /* ---------- portas ---------- */
  .portas{margin-top:clamp(20px,3vw,32px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;}
  .porta{position:relative;display:flex;flex-direction:column;justify-content:flex-end;min-height:300px;border-radius:var(--raio);overflow:hidden;
    border:1px solid var(--line);background:var(--surface);text-decoration:none;color:var(--text);isolation:isolate;
    transition:transform .45s var(--mola),box-shadow .35s ease,border-color .3s ease;}
  .porta:hover{transform:translateY(-4px);box-shadow:0 22px 40px -22px rgba(31,28,20,.35);border-color:var(--line-2);}
  .porta-texto{position:relative;z-index:2;padding:22px;display:flex;flex-direction:column;gap:2px;}
  .porta strong{font-family:var(--display);font-stretch:112%;font-weight:800;font-size:clamp(20px,1vw + 14px,25px);text-transform:uppercase;letter-spacing:.01em;}
  .porta-sub{display:inline-flex;align-items:center;gap:5px;color:var(--body);font-size:14px;}
  .porta-seta{position:absolute;z-index:3;right:18px;bottom:20px;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--ouro-grad);color:var(--sobre-ouro);
    transition:transform .4s var(--mola);}
  .porta:hover .porta-seta{transform:translateY(3px);}

  /* porta com vitrine que gira (a arte ocupa o alto; o texto fica sobre um degradê claro) */
  .porta-arte{position:absolute;inset:0;z-index:0;background:var(--bg-2);overflow:hidden;}
  .porta-vitrine::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(transparent 36%,rgba(255,255,255,.96) 72%);}
  .janela{position:absolute;left:9%;right:9%;top:16px;aspect-ratio:4/3;}
  .janela :global(.quadro){position:absolute;inset:0;margin:0;border-radius:14px;overflow:hidden;background:var(--surface);border:1px solid var(--line);
    box-shadow:0 14px 30px -12px rgba(31,28,20,.3);opacity:0;transform:rotate(-2deg) translateY(10px) scale(.97);transition:opacity .8s ease,transform 1s var(--mola);}
  .janela :global(.quadro.ativo){opacity:1;transform:rotate(-2deg);}
  .janela :global(.quadro img){width:100%;height:100%;object-fit:cover;}
  .janela-tela :global(.quadro){display:flex;flex-direction:column;}
  .janela-tela :global(.quadro img){flex:1;min-height:0;object-position:top left;}
  .barra{flex:none;height:22px;display:flex;align-items:center;gap:5px;padding:0 10px;background:#f1ece0;}
  .barra i{width:6px;height:6px;border-radius:50%;background:var(--line-2);}
  .barra b{margin-left:6px;font-size:10.5px;font-weight:700;color:var(--muted);}
  .stl{flex:1;display:grid;place-items:center;text-align:center;background:linear-gradient(135deg,#fbf6e6,#efe0b2);
    font-family:var(--display);font-stretch:112%;font-weight:800;font-size:clamp(22px,2vw,30px);line-height:1;color:var(--ouro-texto);}

  /* porta com foto */
  .porta-foto{color:#fff;}
  .porta-fundo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 30%;z-index:0;}
  .porta-foto::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(transparent 30%,rgba(25,20,8,.82));}
  .porta-foto .etiqueta{color:var(--ouro-claro);}
  .porta-foto .porta-sub{color:#ece6d6;}

  /* ---------- peças ---------- */
  .acoes{display:flex;flex-wrap:wrap;gap:10px;}
  .pecas{list-style:none;margin:28px 0 0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;}
  .pecas :global(.peca){display:flex;flex-direction:column;height:100%;border-radius:16px;overflow:hidden;background:var(--surface);border:1px solid var(--line);text-decoration:none;
    transition:transform .4s var(--mola),box-shadow .3s ease;}
  .pecas :global(.peca:hover){transform:translateY(-3px);box-shadow:0 18px 30px -20px rgba(31,28,20,.35);}
  .pecas :global(.peca img){width:100%;height:auto;aspect-ratio:1;object-fit:cover;background:var(--bg-2);}
  .pecas :global(.peca-nome){padding:10px 12px 0;font-size:14px;font-weight:600;line-height:1.3;}
  .pecas :global(.peca-preco){margin-top:auto;padding:6px 12px 12px;font-size:14px;font-weight:700;color:var(--ouro-texto);font-variant-numeric:tabular-nums;}
  .tambem{margin-top:20px;color:var(--body);font-size:14.5px;}
  .tambem a{color:var(--ouro-texto);font-weight:600;}

  /* ---------- ferramentas ---------- */
  .ferramentas{list-style:none;margin:28px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;}
  .ferramenta{display:flex;flex-direction:column;height:100%;border-radius:18px;overflow:hidden;background:var(--surface);border:1px solid var(--line);text-decoration:none;
    transition:transform .4s var(--mola),box-shadow .3s ease;}
  .ferramenta:hover{transform:translateY(-3px);box-shadow:0 18px 30px -20px rgba(31,28,20,.35);}
  .ferramenta-tela{display:flex;aspect-ratio:960/713;background:var(--bg-2);border-bottom:1px solid var(--line);overflow:hidden;}
  .ferramenta-tela img{width:100%;height:100%;object-fit:cover;object-position:top left;}
  .ferramenta-corpo{padding:16px 18px 20px;display:flex;flex-direction:column;gap:6px;color:var(--body);font-size:14px;}
  .ferramenta-icone{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--ouro-suave);color:var(--ouro-texto);margin-top:-36px;border:3px solid var(--surface);}
  .ferramenta strong{font-family:var(--display);font-stretch:112%;font-weight:750;font-size:17px;color:var(--text);}

  /* ---------- quem somos ---------- */
  .quem{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:center;}
  .quem-foto img{width:100%;height:auto;border-radius:24px;}
  .verso{margin:24px 0 0;padding:18px 0 0;border-top:1px solid var(--line);}
  .verso blockquote{margin:0;font-size:clamp(17px,.6vw + 14px,20px);font-style:italic;line-height:1.5;max-width:40ch;}
  .verso figcaption{margin-top:8px;color:var(--ouro-texto);font-weight:600;font-size:14px;}
  .onde{margin-top:22px;display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:16px;background:var(--surface);border:1px solid var(--line);color:var(--body);font-size:14px;}
  .onde strong{color:var(--text);font-size:15px;}
  .onde-pino{flex:none;width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--ouro-grad);color:var(--sobre-ouro);}
  .quem-texto .acoes{margin-top:22px;}

  /* ---------- responsivo ---------- */
  @media (max-width:1100px){
    .pecas{grid-template-columns:repeat(3,minmax(0,1fr));}
    .ferramentas{grid-template-columns:repeat(2,minmax(0,1fr));}
  }
  @media (max-width:900px){
    .portas{grid-template-columns:1fr;gap:12px;}
    .porta{min-height:172px;}
    /* no celular a vitrine vai para a metade direita e o texto fica à esquerda */
    .janela{left:50%;right:-8%;top:16px;}
    .porta-vitrine::after{background:linear-gradient(90deg,rgba(255,255,255,.98) 44%,rgba(255,255,255,.6) 62%,transparent 80%);}
    .porta-vitrine .porta-texto{max-width:62%;}
    .porta-texto{padding:18px;}
    .quem{grid-template-columns:1fr;}
    .quem-foto{max-width:440px;}
  }
  @media (max-width:640px){
    .pecas{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}
    .pecas :global(li:nth-child(n+5)){display:none;}
    .ferramentas{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}
    .ferramenta-corpo{padding:12px 12px 14px;font-size:13px;}
    .ferramenta strong{font-size:15px;}
    .ferramenta-icone{width:32px;height:32px;margin-top:-28px;}
    .quem-foto img{aspect-ratio:1;object-fit:cover;object-position:50% 62%;}
    .secao-topo .acoes,.quem-texto .acoes{width:100%;}
    .acoes .botao{flex:1 1 auto;}
  }
</style>

<script>
  // Endereços antigos das abas (#empresas, #eventos, #voce) agora caem em "Para você".
  const ANTIGAS = ["#empresas", "#eventos", "#voce"];
  function abrirPeloHash() {
    if (ANTIGAS.includes(location.hash)) {
      history.replaceState(null, "", "#comprar");
      document.getElementById("comprar")?.scrollIntoView();
    }
  }
  abrirPeloHash();
  addEventListener("hashchange", abrirPeloHash);

  interface Queridinho { codigo: string; nome: string; preco: string; foto: string; link: string }
  const lista = document.querySelector<HTMLUListElement>("[data-pecas]")!;
  const base = lista.dataset.base!;
  const fotoDe = (q: Queridinho) => (/^https?:/.test(q.foto) ? q.foto : base + q.foto);
  const embaralhar = <T,>(xs: T[]) => xs.map((x) => [Math.random(), x] as const).sort((a, b) => a[0] - b[0]).map(([, x]) => x);
  const texto = (s: string) => { const d = document.createElement("div"); d.textContent = s; return d.innerHTML.replace(/"/g, "&quot;"); };

  function mostrar(qs: Queridinho[]) {
    if (!qs.length) return;
    const sorteio = embaralhar(qs);
    lista.innerHTML = sorteio.slice(0, 6).map((q) =>
      `<li><a class="peca" href="${base + q.link}" data-link="catalogo.peca" data-produto="${texto(q.codigo)}" target="_blank" rel="noopener noreferrer">` +
      `<img src="${fotoDe(q)}" alt="${texto(q.nome)}" width="480" height="480" loading="lazy" decoding="async">` +
      `<span class="peca-nome">${texto(q.nome)}</span><span class="peca-preco">R$ ${texto(q.preco)}</span></a></li>`).join("");
    // a vitrine da porta "Quero comprar" mostra outras peças do mesmo sorteio
    const janela = document.querySelector<HTMLElement>("[data-giro='pecas']");
    if (janela) {
      const fotos = (sorteio.length > 6 ? sorteio.slice(6) : sorteio).slice(0, 5);
      janela.innerHTML = fotos.map((q, i) => `<figure class="quadro${i ? "" : " ativo"}"><img src="${fotoDe(q)}" alt="" width="480" height="480" decoding="async"></figure>`).join("");
    }
  }

  let iniciais: Queridinho[] = [];
  try { iniciais = JSON.parse(document.getElementById("queridinhos-iniciais")?.textContent || "[]"); } catch { /* sem lista */ }
  mostrar(iniciais);
  fetch(lista.dataset.fonte!, { cache: "no-cache" })
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((qs: Queridinho[]) => { if (Array.isArray(qs) && qs.length && JSON.stringify(qs) !== JSON.stringify(iniciais)) mostrar(qs); })
    .catch(() => { /* fica com a lista do build */ });

  // Vitrines das portas: trocam sozinhas a cada 3,2 s, só com a porta na tela e sem "reduzir movimento".
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-giro]").forEach((janela) => {
      let visivel = false;
      new IntersectionObserver(([e]) => (visivel = e.isIntersecting)).observe(janela);
      setInterval(() => {
        if (!visivel || document.hidden) return;
        const quadros = [...janela.querySelectorAll(".quadro")];
        if (quadros.length < 2) return;
        const i = quadros.findIndex((q) => q.classList.contains("ativo"));
        quadros[i]?.classList.remove("ativo");
        quadros[(i + 1) % quadros.length].classList.add("ativo");
      }, 3200);
    });
  }
</script>
