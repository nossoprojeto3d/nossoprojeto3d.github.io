---
// Cabeçalho da V4: logo, atalhos para as três seções e WhatsApp. No celular fica só o logo e o WhatsApp,
// porque as três portas logo abaixo já fazem o papel do menu.
import { LINKS, url, whatsapp } from "../../data/links";
---
<header class="topo">
  <div class="container topo-linha">
    <a class="marca" href={url()} aria-label="Nosso Projeto 3D, início">
      <img src={url("assets/logo.png")} alt="" width="36" height="36">
      <span>Nosso Projeto 3D</span>
    </a>
    <nav class="atalhos" aria-label="Seções">
      <a href="#comprar">Comprar</a>
      <a href="#criadores">Criadores</a>
      <a href="#quem-somos">Quem somos</a>
      <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer">Catálogo</a>
    </nav>
    <a class="botao botao-ouro zap-pc" href={whatsapp("menu")} data-link="whatsapp.menu" target="_blank" rel="noopener noreferrer">
      <svg width="18" height="18" aria-hidden="true"><use href="#i-whatsapp"/></svg> Pedir no WhatsApp
    </a>
    <a class="zap-cel" href={whatsapp("menuCelular")} data-link="whatsapp.menuCelular" target="_blank" rel="noopener noreferrer" aria-label="Falar no WhatsApp">
      <svg width="22" height="22" aria-hidden="true"><use href="#i-whatsapp"/></svg>
    </a>
  </div>
</header>

<style>
  .topo{position:sticky;top:0;z-index:50;background:rgba(250,248,242,.86);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
    border-bottom:1px solid transparent;transition:border-color .3s ease;padding-top:env(safe-area-inset-top,0px);}
  .topo-linha{display:flex;align-items:center;gap:24px;min-height:68px;}
  .marca{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--display);font-stretch:112%;font-weight:750;font-size:16px;margin-right:auto;}
  .marca img{width:36px;height:36px;object-fit:contain;}
  .atalhos{display:flex;gap:28px;}
  .atalhos a{text-decoration:none;font-weight:600;font-size:14.5px;color:var(--body);padding:8px 0;}
  .atalhos a:hover{color:var(--text);}
  .zap-pc{min-height:42px;}
  .zap-cel{display:none;width:44px;height:44px;border-radius:12px;place-items:center;background:var(--verde-zap);color:#fff;}
  @media (max-width:900px){
    .atalhos,.zap-pc{display:none;}
    .zap-cel{display:grid;}
  }
</style>
