---
// Páginas antigas (/empresas/, /eventos/, /para-voce/) levam para "Para você" (#comprar) na página única.
// Links compartilhados e o Google continuam funcionando; o canonical aponta pra página única.
import { SITE_URL, url } from "../../data/links";
interface Props { nome: string }
const { nome } = Astro.props;
const destino = url("#comprar");
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{nome} · Nosso Projeto 3D</title>
  <link rel="canonical" href={SITE_URL}>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content={`0; url=${destino}`}>
  <script is:inline define:vars={{ destino }}>location.replace(destino);</script>
  <style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#faf8f2;color:#5c574a;font:16px system-ui,sans-serif;}a{color:#8A6A0A;}</style>
</head>
<body>
  <p>Abrindo <a href={destino}>{nome}</a>…</p>
</body>
</html>
