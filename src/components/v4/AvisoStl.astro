---
// Aviso antes de abrir a pasta dos STLs otimizados no Drive: os modelos são dos criadores do MakerWorld.
// Intercepta qualquer link com data-link="hub.stlsGratis" (cards e rodapé), inclusive com Ctrl/⌘. Sem JS, o link abre direto.
import { LINKS } from "../../data/links";
---
<dialog id="aviso-stl" class="aviso-stl" aria-labelledby="aviso-stl-titulo">
  <div class="aviso-stl-caixa">
    <span class="aviso-stl-icone" aria-hidden="true">⚠</span>
    <h2 id="aviso-stl-titulo">Antes de baixar</h2>
    <p>Os modelos desta pasta foram criados por designers da comunidade e publicados no MakerWorld. Os direitos e a responsabilidade por cada arquivo são do seu criador original.</p>
    <p>A Nosso Projeto 3D só otimiza os arquivos para facilitar a impressão. Os modelos não são nossos, e não nos responsabilizamos por venda, redistribuição ou uso comercial deles.</p>
    <p>Use para impressão pessoal e respeite a licença de cada criador no MakerWorld.</p>
    <div class="aviso-stl-botoes">
      <button type="button" class="botao botao-claro" data-fechar>Voltar</button>
      <a class="botao botao-ouro" href={LINKS.hub.stlsGratis} target="_blank" rel="noopener noreferrer" data-fechar>Entendi, quero baixar <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
  </div>
</dialog>

<style>
  .aviso-stl{border:0;padding:0;background:transparent;max-width:min(480px,calc(100vw - 32px));width:100%;}
  .aviso-stl::backdrop{background:rgba(31,28,20,.55);backdrop-filter:blur(2px);}
  .aviso-stl[open]{animation:aviso-entra .3s var(--mola);}
  .aviso-stl-caixa{background:var(--surface);border:1px solid var(--line);border-radius:var(--raio);padding:28px 24px 24px;
    box-shadow:0 30px 60px -20px rgba(31,28,20,.45);color:var(--body);font:400 15px/1.55 var(--sans);}
  .aviso-stl-icone{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:var(--ouro-suave);color:var(--ouro-texto);font-size:22px;margin-bottom:14px;}
  h2{font:750 22px/1.2 var(--display);color:var(--text);margin:0 0 12px;}
  p{margin:0 0 10px;}
  .aviso-stl-botoes{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;flex-wrap:wrap;}
  @media (max-width:480px){
    .aviso-stl-caixa{padding:24px 18px 18px;font-size:14.5px;}
    .aviso-stl-botoes{flex-direction:column-reverse;}
    .aviso-stl-botoes .botao{width:100%;}
  }
  @keyframes aviso-entra{from{opacity:0;transform:translateY(12px) scale(.97);}to{opacity:1;transform:none;}}
  @media (prefers-reduced-motion:reduce){.aviso-stl[open]{animation:none;}}
</style>

<script>
  const aviso = document.getElementById("aviso-stl") as HTMLDialogElement | null;
  if (aviso && typeof aviso.showModal === "function") {
    document.addEventListener("click", (ev) => {
      const link = (ev.target as Element | null)?.closest?.('a[data-link="hub.stlsGratis"]');
      if (!link) return;
      ev.preventDefault();
      aviso.showModal();
    });
    aviso.addEventListener("click", (ev) => {
      // clique no fundo escuro ou num botão marcado fecha
      if (ev.target === aviso || (ev.target as Element).closest("[data-fechar]")) aviso.close();
    });
  }
</script>
