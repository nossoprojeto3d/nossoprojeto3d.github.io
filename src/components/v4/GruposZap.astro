---
// Botão flutuante "Nossos grupos no WhatsApp" + gaveta com os dois grupos (Nossos Achadinhos e Família Nosso Projeto 3D).
// Cada grupo só aparece com o link preenchido em LINKS.grupos; sem nenhum link, nada é desenhado.
// O botão sobe acima do aviso de cookies (#np3d-cookies, do medicao.js) enquanto ele estiver na tela,
// some quando o rodapé aparece (não cobre os links de lá) e fica por baixo dos diálogos (eles abrem na camada do topo).
import { LINKS } from "../../data/links";

const grupos = [
  {
    chave: "achadinhos",
    href: LINKS.grupos.achadinhos,
    titulo: "Nossos Achadinhos",
    texto: "Cupons de impressão 3D e ferramentas, só quando vale a pena.",
    botao: "Quero os cupons"
  },
  {
    chave: "familia",
    href: LINKS.grupos.familia,
    titulo: "Família Nosso Projeto 3D",
    texto: "Bastidores, novidades e papo de maker com a gente.",
    botao: "Entrar na Família"
  }
].filter((g) => g.href);
---
{grupos.length > 0 && (
  <>
    <button type="button" class="grupos-botao" data-grupos-abrir aria-haspopup="dialog" aria-controls="grupos-gaveta">
      <span class="grupos-av" aria-hidden="true"><span>%</span><span></span></span>
      <span>Nossos grupos<span class="grupos-longo"> no WhatsApp</span></span>
      <span class="grupos-ponto" aria-hidden="true"></span>
    </button>

    <dialog id="grupos-gaveta" class="grupos-gaveta" aria-labelledby="grupos-titulo">
      <div class="grupos-caixa">
        <span class="grupos-alca" aria-hidden="true"></span>
        <button type="button" class="grupos-fechar" data-grupos-fechar aria-label="Fechar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <h2 id="grupos-titulo">Entra pros nossos grupos</h2>
        <p class="grupos-sub">{grupos.length > 1 ? "Escolhe um, ou os dois." : "É só tocar pra entrar."}</p>

        {grupos.map((g) => (
          <a class={`grupo grupo-${g.chave}`} href={g.href} data-link={`grupos.${g.chave}`} data-evento="clique_grupo" data-grupo={g.chave} target="_blank" rel="noopener noreferrer">
            {g.chave === "achadinhos" && <span class="grupo-ticket" aria-hidden="true">% OFF</span>}
            <b>{g.titulo}</b>
            <small>{g.texto}</small>
            <span class="grupo-acao">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.8-1.1-4.6-4-4.8-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.6-.3.4c-.1.1-.2.3-.1.5.2.3.7 1.2 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.3.1.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l1.9.9c.3.1.4.2.5.3.1.2.1.7-.1 1.3z"/></svg>
              {g.botao}
            </span>
          </a>
        ))}
      </div>
    </dialog>
  </>
)}

<style>
  /* cores do app Nossos Achadinhos (verde tapete de corte + amarelo), só nesta gaveta */
  .grupos-gaveta{--achado-verde:#183d2c;--achado-amarelo:#f4c430;--achado-creme:#fbf3d8;--achado-texto:#cfdccf;}

  /* ---------- botão flutuante ---------- */
  .grupos-botao{position:fixed;z-index:40;left:50%;bottom:calc(max(16px,env(safe-area-inset-bottom)) + var(--grupos-sobe,0px));
    display:flex;align-items:center;gap:10px;min-height:48px;padding:7px 18px 7px 8px;border:0;border-radius:99px;cursor:pointer;
    background:#1f1c14;color:#fff;font:600 15px/1 var(--sans);white-space:nowrap;-webkit-tap-highlight-color:transparent;
    box-shadow:0 14px 30px -10px rgba(31,28,20,.6);
    transform:translate(-50%,0);transition:transform .45s var(--mola),opacity .3s ease,bottom .35s var(--mola);}
  .grupos-botao:active{transform:translate(-50%,0) scale(.96);}
  /* entra depois de um instante, pra chamar o olho sem brigar com a abertura */
  .grupos-botao.escondido{opacity:0;transform:translate(-50%,140%);pointer-events:none;}
  .grupos-botao{max-width:calc(100vw - 24px);}
  /* iPhone SE e telas estreitas: "Nossos grupos" só */
  @media (max-width:359px){.grupos-longo{display:none;}}
  .grupos-av{display:flex;}
  .grupos-av span{width:32px;height:32px;border-radius:50%;border:2px solid #1f1c14;margin-left:-9px;display:grid;place-items:center;}
  .grupos-av span:first-child{margin-left:0;background:#183d2c;color:#f4c430;font:800 13px/1 var(--display);}
  .grupos-av span:last-child{background:#fff url(/assets/logo.png) center/70% no-repeat;}
  .grupos-ponto{width:8px;height:8px;border-radius:50%;background:#25d366;box-shadow:0 0 0 0 rgba(37,211,102,.6);animation:grupos-pulsa 1.8s infinite;}
  @keyframes grupos-pulsa{70%{box-shadow:0 0 0 8px rgba(37,211,102,0);}100%{box-shadow:0 0 0 0 rgba(37,211,102,0);}}
  /* computador: canto direito, sem tapar o centro da página */
  @media (min-width:901px){
    .grupos-botao{left:auto;right:24px;transform:none;}
    .grupos-botao:active{transform:scale(.96);}
    .grupos-botao.escondido{transform:translateY(140%);}
    .grupos-botao:hover{transform:translateY(-2px);}
  }

  /* ---------- gaveta (abre de baixo no celular, centralizada no computador) ---------- */
  .grupos-gaveta{border:0;padding:0;background:transparent;width:100%;max-width:520px;max-height:calc(100dvh - 24px);
    margin:auto auto 0;overflow:visible;color:var(--text);}
  .grupos-gaveta::backdrop{background:rgba(20,16,6,.45);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);}
  .grupos-gaveta[open]{animation:grupos-sobe .4s var(--mola);}
  .grupos-caixa{position:relative;background:var(--bg);border-radius:26px 26px 0 0;max-height:calc(100dvh - 24px);overflow-y:auto;
    padding:10px 20px calc(24px + env(safe-area-inset-bottom));box-shadow:0 -20px 40px -20px rgba(0,0,0,.4);}
  @media (min-width:600px){
    .grupos-gaveta{margin:auto;}
    .grupos-caixa{border-radius:24px;padding:24px 24px 24px;}
    .grupos-alca{display:none !important;}
  }
  .grupos-alca{display:block;width:40px;height:5px;border-radius:9px;background:var(--line-2);margin:0 auto 14px;}
  .grupos-fechar{position:absolute;top:12px;right:12px;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);
    background:var(--surface);color:var(--text);display:grid;place-items:center;cursor:pointer;}
  .grupos-caixa h2{font:800 23px/1.1 var(--display);font-stretch:112%;letter-spacing:-.02em;margin:0;padding-right:52px;}
  .grupos-sub{color:var(--body);margin-top:6px;font-size:15px;}

  .grupo{display:block;position:relative;overflow:hidden;margin-top:14px;padding:18px;border-radius:20px;text-decoration:none;
    transition:transform .3s var(--mola);}
  .grupo:active{transform:scale(.98);}
  .grupo b{display:block;font:800 19px/1.15 var(--display);font-stretch:112%;letter-spacing:-.01em;}
  .grupo small{display:block;margin-top:5px;font-size:14.5px;line-height:1.4;}
  .grupo-acao{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:14px;min-height:48px;border-radius:14px;font:600 15px/1 var(--sans);}
  .grupo-achadinhos{background:var(--achado-verde);color:#fff;}
  .grupo-achadinhos small{color:var(--achado-texto);max-width:24ch;}
  .grupo-achadinhos .grupo-acao{background:var(--achado-amarelo);color:var(--achado-verde);}
  .grupo-ticket{position:absolute;right:14px;top:16px;transform:rotate(8deg);background:var(--achado-creme);color:var(--achado-verde);
    font:800 18px/1 var(--display);padding:10px 12px;border-radius:10px;border-left:3px dashed var(--achado-verde);}
  .grupo-familia{background:var(--surface);border:1px solid var(--line);color:var(--text);}
  .grupo-familia small{color:var(--body);}
  .grupo-familia .grupo-acao{background:var(--verde-zap);color:#fff;}

  @keyframes grupos-sobe{from{transform:translateY(40px);opacity:0;}to{transform:none;opacity:1;}}
  @media (prefers-reduced-motion:reduce){
    .grupos-botao{transition:opacity .2s ease;}
    .grupos-ponto{animation:none;}
    .grupos-gaveta[open]{animation:none;}
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>("[data-grupos-abrir]");
  const gaveta = document.getElementById("grupos-gaveta") as HTMLDialogElement | null;

  if (botao && gaveta) {
    // ---- abrir e fechar ----
    const fechar = () => gaveta.close();
    if (typeof gaveta.showModal === "function") {
      botao.addEventListener("click", () => {
        gaveta.showModal();
        document.documentElement.style.overflow = "hidden";
        (window as any).np3dTrack?.("abrir_grupos", { local: "botao_flutuante" });
      });
      gaveta.addEventListener("close", () => { document.documentElement.style.overflow = ""; });
      gaveta.addEventListener("click", (ev) => {
        const alvo = ev.target as Element;
        // toque no fundo escuro, no X ou num grupo (o grupo abre em nova aba) fecha a gaveta
        if (alvo === gaveta || alvo.closest("[data-grupos-fechar]") || alvo.closest(".grupo")) fechar();
      });
    } else {
      // navegador sem <dialog>: o botão leva direto ao primeiro grupo
      const primeiro = gaveta.querySelector<HTMLAnchorElement>(".grupo");
      botao.addEventListener("click", () => { if (primeiro) window.open(primeiro.href, "_blank", "noopener"); });
    }

    // ---- quando aparecer ----
    let rodapeNaTela = false;
    let entrou = false;
    const atualizar = () => botao.classList.toggle("escondido", !entrou || rodapeNaTela);
    botao.classList.add("escondido");
    setTimeout(() => { entrou = true; atualizar(); }, 1200);

    const rodape = document.querySelector("footer");
    if (rodape && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => { rodapeNaTela = e.isIntersecting; atualizar(); }).observe(rodape);
    }

    // ---- aviso de cookies: o botão sobe acima dele enquanto ele estiver na tela ----
    let medidor: ResizeObserver | null = null;
    const acompanharCookies = () => {
      const aviso = document.getElementById("np3d-cookies");
      medidor?.disconnect();
      medidor = null;
      if (!aviso) { botao.style.removeProperty("--grupos-sobe"); return; }
      const subir = () => botao.style.setProperty("--grupos-sobe", `${aviso.offsetHeight + 10}px`);
      subir();
      if ("ResizeObserver" in window) { medidor = new ResizeObserver(subir); medidor.observe(aviso); }
    };
    acompanharCookies();
    new MutationObserver(acompanharCookies).observe(document.body, { childList: true });
  }
</script>
