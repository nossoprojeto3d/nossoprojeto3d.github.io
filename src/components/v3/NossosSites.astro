---
// Nossos sites (V3): onde comprar e acompanhar, e as ferramentas que criamos para quem também imprime em 3D.
import { GRUPOS_SITES as grupos } from "../../data/sites";
---
<section class="secao sites" id="nossos-sites" aria-labelledby="sites-titulo">
  <div class="container">
    <div class="sites-topo surge">
      <span class="etiqueta">Nossos sites</span>
      <h2 id="sites-titulo">Todos nossos projetos, num lugar só.</h2>
    </div>
    {grupos.map((g) => (
      <div class="grupo">
        <h3 class="legenda">{g.titulo}</h3>
        <ul>
          {g.sites.map((s) => (
            <li class="surge">
              <a href={s.href} data-link={s.link} target="_blank" rel="noopener noreferrer" class="cartao" data-inclinar>
                <span class="cartao-miolo">
                  <span class="cartao-icone"><svg width="22" height="22" aria-hidden="true"><use href={`#${s.icone}`}/></svg></span>
                  <span class="cartao-nome">{s.nome}</span>
                  <span class="cartao-texto">{s.texto}</span>
                  <span class="cartao-seta" aria-hidden="true"><svg width="18" height="18"><use href="#i-arrow"/></svg></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .sites{border-top:1px solid var(--line);}
  .sites-topo{display:flex;flex-direction:column;align-items:flex-start;gap:20px;}
  h2{font-size:var(--fs-h2);line-height:1.02;max-width:16ch;}
  .grupo{margin-top:56px;}
  .grupo ul{margin:16px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;}
  .grupo li{display:flex;}

  /* cartão com moldura dupla; inclina em 3D com o mouse (data-inclinar, script no layout) */
  .cartao{flex:1;display:flex;padding:6px;border-radius:26px;background:rgba(255,255,255,.03);border:1px solid var(--line);transition:border-color .4s ease;}
  .cartao:hover{border-color:var(--line-2);}
  .cartao-miolo{position:relative;flex:1;display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto 1fr;gap:10px 16px;padding:24px;border-radius:20px;
    background:radial-gradient(ellipse 80% 80% at var(--gx,20%) var(--gy,0%),rgba(255,255,255,.06),transparent 60%),var(--bg-2);box-shadow:inset 0 1px 0 rgba(255,255,255,.05);}
  .cartao-icone{grid-row:span 2;width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:var(--surface-2);border:1px solid var(--line-2);color:var(--ouro-claro);}
  .cartao-nome{font-weight:600;font-size:18px;letter-spacing:-.02em;align-self:center;padding-right:36px;}
  .cartao-texto{font-size:var(--fs-small);line-height:1.55;color:var(--muted);}
  .cartao-seta{position:absolute;top:20px;right:20px;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.06);color:var(--body);
    transition:transform .5s var(--mola),background-color .3s ease,color .3s ease;}
  .cartao:hover .cartao-seta{transform:translate(2px,-2px) scale(1.08);background:var(--ouro);color:var(--sobre-ouro);}

  @media (max-width:900px){
    .grupo ul{grid-template-columns:1fr;gap:10px;}
    .cartao-miolo{padding:18px;}
  }
</style>
