---
// Onde atendemos (V3): o Brasil em 3D com arcos de envio saindo de Goiânia (src/scripts/mapa3d.ts).
// Sem WebGL, ou até o 3D carregar, aparece o mapa plano em SVG, desenhado no build (src/data/mapa.ts).
import { LARGURA, ALTURA, contorno, goiania, raioRegiao, rotas } from "../../data/mapa";
const [gx, gy] = goiania;
const dados = { largura: LARGURA, contorno, goiania, raioRegiao, rotas: rotas.map(({ nome, x, y }) => ({ nome, x, y })) };
---
<section class="secao entrega" id="entrega" aria-labelledby="entrega-titulo">
  <div class="container entrega-grade">
    <div class="entrega-texto surge">
      <span class="etiqueta">Onde atendemos</span>
      <h2 id="entrega-titulo">De Goiânia para todo o Brasil.</h2>
      <p class="entrega-lead">Produzimos tudo aqui em Goiânia. Daqui, a peça segue até você, camada por camada desse Brasil.</p>
      <dl class="lista">
        <div>
          <dt><span class="marca marca-regiao" aria-hidden="true"></span>Goiânia e região</dt>
          <!-- .ph: texto a confirmar pelos donos -->
          <dd class="ph">Entrega ou retirada combinada pelo WhatsApp.</dd>
        </div>
        <div>
          <dt><span class="marca marca-rota" aria-hidden="true"></span>Todo o Brasil</dt>
          <dd>Enviamos com segurança e qualidade pelas principais transportadoras do Brasil.</dd>
        </div>
      </dl>
    </div>

    <figure class="mapa">
      <svg class="mapa-plano" viewBox={`0 0 ${LARGURA} ${ALTURA}`} role="img" aria-label="Mapa do Brasil com rotas de envio saindo de Goiânia para as capitais">
        <path d={contorno} class="plano-pais" />
        {rotas.map((r) => <path d={r.d} class="plano-rota" />)}
        <circle cx={gx} cy={gy} r={raioRegiao} class="plano-regiao" />
        <circle cx={gx} cy={gy} r="5" class="plano-sede" />
      </svg>
      <canvas aria-hidden="true"></canvas>
      <script type="application/json" id="dados-mapa" set:html={JSON.stringify(dados)} />
    </figure>
  </div>
</section>

<style>
  .entrega{border-top:1px solid var(--line);}
  .entrega-grade{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(32px,5vw,72px);align-items:center;}
  h2{margin-top:20px;font-size:var(--fs-h2);line-height:1.02;}
  .entrega-lead{margin-top:20px;max-width:40ch;font-size:var(--fs-lead);line-height:1.6;color:var(--body);}
  .lista{margin:36px 0 0;display:grid;}
  .lista div{padding:18px 0;border-top:1px solid var(--line);}
  .lista div:last-child{border-bottom:1px solid var(--line);}
  dt{display:flex;align-items:center;gap:12px;font-weight:500;font-size:17px;}
  dd{margin:8px 0 0 24px;color:var(--muted);line-height:1.6;}
  .ph{text-decoration:underline dashed rgba(232,200,115,.5);text-underline-offset:5px;}
  .marca{width:12px;height:12px;border-radius:50%;flex:0 0 12px;}
  .marca-regiao{background:var(--ouro-claro);box-shadow:0 0 0 4px rgba(232,200,115,.18),0 0 14px rgba(232,200,115,.6);}
  .marca-rota{border:1.5px dashed var(--ouro);}

  .mapa{position:relative;margin:0;aspect-ratio:1.1;}
  .mapa canvas,.mapa-plano{position:absolute;inset:0;width:100%;height:100%;}
  .mapa canvas{opacity:0;transition:opacity .9s ease;}
  .mapa canvas[data-pronto]{opacity:1;}
  .mapa-plano{padding:6%;transition:opacity .6s ease;}
  .mapa:has(canvas[data-pronto]) .mapa-plano{opacity:0;}
  .plano-pais{fill:var(--surface);stroke:#3a3426;stroke-width:1;}
  .plano-rota{fill:none;stroke:var(--ouro);stroke-width:1.2;opacity:.7;}
  .plano-regiao{fill:rgba(201,162,39,.12);stroke:var(--ouro-claro);stroke-dasharray:3 3;}
  .plano-sede{fill:var(--ouro-claro);}

  @media (max-width:900px){
    .entrega-grade{grid-template-columns:1fr;}
    .mapa{width:min(100%,560px);margin:0 auto;}
  }
</style>

<script>
  import type { DadosMapa } from "../../scripts/mapa3d";
  // o 3D do mapa só carrega quando a seção está chegando na tela
  const figura = document.querySelector<HTMLElement>(".mapa")!;
  new IntersectionObserver((entradas, obs) => {
    if (!entradas[0].isIntersecting) return;
    obs.disconnect();
    const dados = JSON.parse(document.getElementById("dados-mapa")!.textContent!) as DadosMapa;
    import("../../scripts/mapa3d").then(({ criarMapa }) => criarMapa(figura.querySelector("canvas")!, dados));
  }, { rootMargin: "300px" }).observe(figura);
</script>
