---
// Rodapé (V3), no estilo dos grandes sites:
// 1) chamada final com os dois botões; 2) diretório de links; 3) linha de status com a hora de Goiânia e "voltar ao topo";
// 4) o nome gigante, que se "imprime" em camadas quando chega na tela; 5) linha legal.
import { LINKS, url, whatsapp } from "../../data/links";
import { GRUPOS_SITES } from "../../data/sites";

const ano = new Date().getFullYear();
const [comprar, makers] = GRUPOS_SITES;
const colunas = [
  {
    titulo: "Navegar",
    links: [
      { nome: "Para empresas", href: url("#empresas") },
      { nome: "Para eventos", href: url("#eventos") },
      { nome: "Para você", href: url("#voce") },
      { nome: "Quem somos", href: url("#quem-somos") }
    ]
  },
  { titulo: "Comprar", links: comprar.sites.filter((s) => s.nome !== "Instagram").map((s) => ({ nome: s.nome, href: s.href, link: s.link, fora: true })) },
  { titulo: "Para makers", links: makers.sites.map((s) => ({ nome: s.nome, href: s.href, link: s.link, fora: true })) },
  {
    titulo: "Contato",
    links: [
      { nome: "WhatsApp", href: whatsapp("rodapeContato"), link: "whatsapp.rodapeContato", fora: true },
      { nome: "Instagram", href: LINKS.contato.instagram, link: "contato.instagram", fora: true }
    ]
  }
] as { titulo: string; links: { nome: string; href: string; link?: string; fora?: boolean }[] }[];
---
<footer class="rodape">
  <section class="chamada container" aria-labelledby="chamada-titulo">
    <div class="moldura">
      <div class="chamada-miolo">
        <span class="etiqueta">Vamos começar?</span>
        <h2 id="chamada-titulo">Tem uma ideia? A gente transforma em realidade.</h2>
        <p>Mande uma foto, um desenho ou só a ideia. Vamos tirar ela do digital.</p>
        <div class="chamada-botoes">
          <a href={LINKS.catalogo.site} data-link="catalogo.site" target="_blank" rel="noopener noreferrer" class="botao botao-claro">
            Ver catálogo <span class="ilha"><svg width="18" height="18" aria-hidden="true"><use href="#i-arrow"/></svg></span>
          </a>
          <a href={whatsapp("chamadaFinal")} data-link="whatsapp.chamadaFinal" target="_blank" rel="noopener noreferrer" class="botao botao-ouro">
            Pedir no WhatsApp <span class="ilha"><svg width="18" height="18" aria-hidden="true"><use href="#i-whatsapp"/></svg></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="diretorio">
      <div class="marca-col">
        <a href={url()} class="marca" aria-label="Nosso Projeto 3D, início">
          <img src={url("assets/logo.png")} alt="" width="254" height="300">
          <span translate="no">Nosso Projeto 3D</span>
        </a>
        <p>Impressão 3D para empresas, eventos e para você. Goiânia-GO, com envio para todo o Brasil.</p>
        <div class="redes">
          <a href={LINKS.contato.instagram} data-link="contato.instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg width="18" height="18" aria-hidden="true"><use href="#i-instagram"/></svg></a>
          <a href={whatsapp("rodapeIcone")} data-link="whatsapp.rodapeIcone" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg width="18" height="18" aria-hidden="true"><use href="#i-whatsapp"/></svg></a>
        </div>
      </div>
      <nav class="colunas" aria-label="Rodapé">
        {colunas.map((c) => (
          <div>
            <h3 class="legenda">{c.titulo}</h3>
            <ul>
              {c.links.map((l) => (
                <li><a href={l.href} data-link={l.link} target={l.fora ? "_blank" : undefined} rel={l.fora ? "noopener noreferrer" : undefined}>{l.nome}{l.fora && <svg width="12" height="12" aria-hidden="true"><use href="#i-arrow"/></svg>}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="status">
      <p class="legenda"><span class="ponto" aria-hidden="true"></span>Goiânia, GO · <time data-relogio>--:--</time></p>
      <p class="legenda">Envio para todo o Brasil</p>
      <button type="button" class="topo legenda" data-topo>Voltar ao topo <svg width="14" height="14" aria-hidden="true"><use href="#i-arrow"/></svg></button>
    </div>
  </div>

  <!-- nome gigante em ouro, com as linhas de camada à mostra. Ao entrar na tela ele se "imprime" de baixo pra cima,
       com a linha do bico subindo, e depois um reflexo de luz passa pelas letras de tempos em tempos.
       Feito em HTML/CSS (e não SVG) porque o Safari do iPhone ignora o textLength e cortava as pontas. -->
  <div class="gigante container" aria-hidden="true" data-gigante>
    <div class="gigante-caixa">
      <span class="gigante-nome">Nosso Projeto 3D</span>
      <span class="gigante-bico"></span>
    </div>
  </div>

  <div class="container legal">
    <span>© {ano} Nosso Projeto 3D</span>
    <span>Feito com amor, trabalho e propósito.</span>
  </div>
</footer>

<style>
  .rodape{position:relative;padding-top:clamp(64px,8vw,120px);border-top:1px solid var(--line);overflow:clip;}
  /* brilho dourado bem fraco subindo do fundo */
  .rodape::before{content:"";position:absolute;left:50%;bottom:-40%;width:min(1400px,200vw);aspect-ratio:2;transform:translateX(-50%);pointer-events:none;
    background:radial-gradient(ellipse at 50% 100%,rgba(201,162,39,.12),transparent 60%);}

  /* 1) chamada final */
  .chamada-miolo{position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;text-align:center;padding:clamp(48px,7vw,96px) clamp(20px,5vw,64px);border-radius:25px;
    background:radial-gradient(ellipse 60% 80% at 50% 0%,rgba(201,162,39,.14),transparent 70%),var(--bg-2);box-shadow:inset 0 1px 0 rgba(255,255,255,.06);}
  .chamada h2{margin-top:20px;font-size:var(--fs-h2);line-height:1.02;max-width:16ch;}
  .chamada p{margin-top:20px;max-width:44ch;color:var(--body);font-size:var(--fs-lead);line-height:1.55;}
  .chamada-botoes{margin-top:36px;display:flex;flex-wrap:wrap;justify-content:center;gap:12px;}

  /* 2) diretório */
  .diretorio{margin-top:clamp(72px,9vw,128px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:48px;}
  .marca{display:inline-flex;align-items:center;gap:10px;}
  .marca img{height:30px;width:auto;}
  .marca span{font-weight:600;font-size:17px;letter-spacing:-.02em;}
  .marca-col p{margin-top:18px;max-width:34ch;font-size:var(--fs-small);line-height:1.65;color:var(--muted);}
  .redes{margin-top:22px;display:flex;gap:8px;}
  .redes a{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line-2);color:var(--body);transition:color .3s ease,border-color .3s ease,transform .5s var(--mola);}
  .redes a:hover{color:var(--ouro-claro);border-color:var(--ouro);transform:translateY(-2px);}
  .colunas{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px;}
  .colunas h3{margin:0 0 18px;font-weight:400;}
  /* área de toque de ~40 px no celular, com o mesmo espaçamento visual de antes */
  .colunas ul{margin:-9px 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:0;}
  .colunas a{display:inline-flex;align-items:center;gap:6px;padding:9px 0;font-size:var(--fs-small);color:var(--body);transition:color .3s ease;}
  .colunas a svg{opacity:0;transform:translate(-4px,2px);transition:opacity .3s ease,transform .5s var(--mola);}
  .colunas a:hover{color:var(--text);}
  .colunas a:hover svg{opacity:1;transform:none;}

  /* 3) status */
  .status{margin-top:64px;padding:20px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;justify-content:space-between;}
  .status p{display:flex;align-items:center;gap:10px;}
  .ponto{width:7px;height:7px;border-radius:50%;background:var(--ouro);box-shadow:0 0 0 0 rgba(201,162,39,.6);animation:pulso 2.4s ease-out infinite;}
  @keyframes pulso{70%{box-shadow:0 0 0 8px rgba(201,162,39,0);}100%{box-shadow:0 0 0 0 rgba(201,162,39,0);}}
  .topo{display:inline-flex;align-items:center;gap:8px;padding:8px 0;border:0;background:none;cursor:pointer;transition:color .3s ease;}
  .topo svg{transform:rotate(-45deg);transition:transform .5s var(--mola);}
  .topo:hover{color:var(--text);}
  .topo:hover svg{transform:rotate(-45deg) translate(2px,-2px);}

  /* 4) nome gigante: a fonte acompanha a largura da caixa (cqi), então cabe numa linha em qualquer tela */
  .gigante{margin-top:clamp(32px,5vw,64px);}
  .gigante-caixa{position:relative;container-type:inline-size;}
  .gigante-nome{display:block;text-align:center;white-space:nowrap;font-weight:600;font-size:12.4cqi;line-height:1.08;letter-spacing:-.045em;padding-bottom:.06em;
    /* camadas (faixas escuras finas) sobre o ouro, e um reflexo claro que fica fora da letra até a animação passar */
    background:
      linear-gradient(105deg,transparent 40%,rgba(255,250,230,.85) 50%,transparent 60%) -150% 0/50% 100% no-repeat,
      repeating-linear-gradient(180deg,transparent 0 3px,rgba(20,14,4,.55) 3px 4px),
      linear-gradient(180deg,#F3DC8E,#C9A227 48%,#6B5418);
    -webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;
    filter:drop-shadow(0 0 22px rgba(201,162,39,.3));}
  .gigante-bico{position:absolute;left:0;right:0;bottom:0;height:2px;border-radius:2px;opacity:0;pointer-events:none;
    background:linear-gradient(90deg,transparent,var(--ouro-claro) 15%,#fff 50%,var(--ouro-claro) 85%,transparent);box-shadow:0 0 18px 4px rgba(232,200,115,.55);}
  @media (prefers-reduced-motion:no-preference){
    /* escondido só quando o script avisou que vai animar; sem script, o nome aparece pronto */
    .gigante:global(.vai-imprimir) .gigante-nome{clip-path:inset(100% -6% -30% -6%);}
    .gigante:global(.impresso) .gigante-nome{clip-path:inset(-30% -6% -30% -6%);transition:clip-path 1.8s cubic-bezier(.45,.05,.35,1);
      animation:reflexo 7s ease-in-out 2s infinite;}
    .gigante:global(.impresso) .gigante-bico{animation:bico 1.8s cubic-bezier(.45,.05,.35,1) both;}
    @keyframes bico{0%{bottom:0;opacity:1;}92%{bottom:100%;opacity:1;}100%{bottom:100%;opacity:0;}}
    @keyframes reflexo{0%{background-position:-150% 0,0 0,0 0;}30%,100%{background-position:250% 0,0 0,0 0;}}
  }

  /* 5) legal */
  .legal{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;padding-top:24px;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 28px);font-size:12.5px;color:var(--muted);}

  @media (max-width:900px){
    .diretorio{grid-template-columns:1fr;}
    .colunas{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 24px;}
  }
  @media (max-width:560px){
    .chamada-botoes{width:100%;}
    .chamada-botoes .botao{width:100%;}
    .status{flex-direction:column;align-items:flex-start;}
  }
</style>

<script>
  // nome gigante: imprime quando aparece na tela
  const gigante = document.querySelector<HTMLElement>("[data-gigante]");
  if (gigante && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gigante.classList.add("vai-imprimir");
    new IntersectionObserver(([e], obs) => {
      if (!e.isIntersecting) return;
      obs.disconnect();
      gigante.classList.add("impresso");
    }, { threshold: 0.6 }).observe(gigante);
  }

  // hora de Goiânia (mesmo fuso de Brasília), atualizada a cada 20 s
  const relogio = document.querySelector<HTMLTimeElement>("[data-relogio]");
  if (relogio) {
    const formato = new Intl.DateTimeFormat("pt-BR", { timeZone: "America/Sao_Paulo", hour: "2-digit", minute: "2-digit" });
    const atualizar = () => (relogio.textContent = formato.format(new Date()));
    atualizar();
    setInterval(atualizar, 20000);
  }
  document.querySelector("[data-topo]")?.addEventListener("click", () => {
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    scrollTo({ top: 0, behavior: quieto ? "auto" : "smooth" });
  });
</script>
