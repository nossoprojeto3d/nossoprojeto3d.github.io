---
// Quem somos (V3): foto do casal, resumo, o versículo à mostra e a história completa num diálogo (Historia.astro).
import { url } from "../../data/links";
---
<section class="secao quem" id="quem-somos" aria-labelledby="quem-titulo">
  <div class="container quem-grade">
    <div class="quem-foto surge">
      <div class="moldura" data-inclinar>
        <img src={url("assets/fotos/01-casal.jpg")} alt="Ilustração de Júnior e Thairine no escritório, com um modelo 3D na tela do computador" width="1080" height="1350" loading="lazy" decoding="async">
      </div>
    </div>
    <div class="quem-texto surge">
      <span class="etiqueta">Quem somos</span>
      <h2 id="quem-titulo">Um casal construindo junto, com propósito e fé.</h2>
      <p class="quem-lead">Júnior é engenheiro de software e Thairine é arquiteta. Cada peça passa pelas nossas mãos, do projeto ao acabamento.</p>
      <figure class="verso">
        <blockquote>“Confia ao Senhor as tuas obras, e os teus desígnios serão estabelecidos.”</blockquote>
        <figcaption class="legenda">Provérbios 16:3</figcaption>
      </figure>
      <button type="button" class="botao botao-claro" data-abre="historia">
        Conheça nossa história <span class="ilha"><svg width="18" height="18" aria-hidden="true"><use href="#i-right"/></svg></span>
      </button>
    </div>
  </div>
</section>

<style>
  .quem{border-top:1px solid var(--line);}
  .quem-grade{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr);gap:clamp(40px,7vw,112px);align-items:center;}
  .quem-foto img{width:100%;height:auto;border-radius:25px;}
  h2{margin-top:20px;font-size:var(--fs-h2);line-height:1.02;}
  .quem-lead{margin-top:24px;max-width:46ch;font-size:var(--fs-lead);line-height:1.6;color:var(--body);}
  .verso{margin:36px 0 0;padding:24px 0 0;border-top:1px solid var(--line);}
  .verso blockquote{margin:0;font-size:clamp(18px,.8vw + 14px,22px);line-height:1.5;font-style:italic;color:var(--text);max-width:40ch;}
  .verso figcaption{margin-top:12px;color:var(--ouro-claro);}
  .botao{margin-top:36px;}
  @media (max-width:900px){
    .quem-grade{grid-template-columns:1fr;}
    .quem-foto{width:min(100%,420px);}
  }
  @media (max-width:560px){
    /* no celular a foto vira quadrada, centrada nos rostos, pra o texto aparecer logo */
    .quem-foto img{aspect-ratio:1;object-fit:cover;object-position:50% 62%;}
    .botao{width:100%;}
  }
</style>
