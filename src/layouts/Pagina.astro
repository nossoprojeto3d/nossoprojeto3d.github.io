---
// Layout da V4 (página clara de três portas: comprar, criadores e quem somos).
import "../styles/v4.css";
import Icones from "../components/Icones.astro";
import Topo from "../components/v4/Topo.astro";
import Rodape from "../components/v4/Rodape.astro";
import { LINKS, SITE_URL, TELEFONE, url } from "../data/links";

interface Props {
  titulo: string;
  descricao: string;
  /** página que não deve ir pro Google (404) */
  semIndice?: boolean;
}
const { titulo, descricao, semIndice = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, "https://nossoprojeto3d.com.br").href;
// ?v=: muda quando a imagem muda, senão o WhatsApp continua mostrando a prévia antiga guardada em cache
const og = `${SITE_URL}assets/og/og-image.jpg?v=3`;

const negocio = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Nosso Projeto 3D",
  description: "Impressão 3D em Goiânia: peças personalizadas, presentes e decoração, e ferramentas gratuitas para quem imprime.",
  url: SITE_URL,
  logo: `${SITE_URL}assets/logo.png`,
  image: og,
  telephone: TELEFONE,
  address: { "@type": "PostalAddress", addressLocality: "Goiânia", addressRegion: "GO", addressCountry: "BR" },
  areaServed: [{ "@type": "City", name: "Goiânia" }, { "@type": "Country", name: "Brasil" }],
  founder: [{ "@type": "Person", name: "Júnior" }, { "@type": "Person", name: "Thairine" }],
  sameAs: [LINKS.contato.instagram, LINKS.hub.shopee, LINKS.catalogo.site]
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{titulo}</title>
  <meta name="description" content={descricao}>
  <meta name="theme-color" content="#faf8f2">
  {semIndice ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonica}>}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Nosso Projeto 3D">
  <meta property="og:url" content={canonica}>
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descricao}>
  <meta property="og:image" content={og}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Logo NP dourado ao lado da frase: Ideias que ganham forma, camada por camada.">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={url("assets/icons/favicon.ico")} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={url("assets/icons/favicon-32.png")}>
  <link rel="icon" type="image/png" sizes="64x64" href={url("assets/icons/favicon-64.png")}>
  <link rel="apple-touch-icon" href={url("assets/icons/apple-touch-icon.png")}>
  <link rel="manifest" href={url("manifest.webmanifest")}>
  <meta name="apple-mobile-web-app-title" content="Projeto 3D">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@112,600;112,750;112,800&family=Instrument+Sans:wght@400;500;600;700&display=swap">
  <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
  <script is:inline src={url("assets/medicao.js")} defer></script>
</head>
<body data-medir-secoes>
  <a href="#topo" class="pular">Pular para o conteúdo</a>
  <Icones />

  <Topo />

  <main id="topo" tabindex="-1">
    <slot />
  </main>

  <Rodape />
  <script>
    // .surge: aparece ao chegar na tela. A página começa visível; só ganha o efeito se o JS rodar.
    const surgem = document.querySelectorAll(".surge");
    if (surgem.length && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("anima");
      const io = new IntersectionObserver((itens) => itens.forEach((i) => { if (i.isIntersecting) { i.target.classList.add("visto"); io.unobserve(i.target); } }), { rootMargin: "0px 0px -8% 0px" });
      surgem.forEach((el) => io.observe(el));
    }
  </script>
</body>
</html>

