---
// Layout da V3 (página única, escuro neutro). O Base.astro continua servindo as páginas antigas até a V3 ser aprovada.
import "../styles/v3.css";
import Icones from "../components/Icones.astro";
import Menu from "../components/v3/Menu.astro";
import Rodape from "../components/v3/Rodape.astro";
import { LINKS, SITE_URL, TELEFONE, url } from "../data/links";

interface Props {
  titulo: string;
  descricao: string;
  /** página que não deve ir pro Google (404) */
  semIndice?: boolean;
}
const { titulo, descricao, semIndice = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, "https://nossoprojeto3d.github.io").href;
// ?v=: muda quando a imagem muda, senão o WhatsApp continua mostrando a prévia antiga guardada em cache
const og = `${SITE_URL}assets/og/og-image.jpg?v=3`;

const negocio = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Nosso Projeto 3D",
  description: "Impressão 3D em Goiânia: brindes com logo e expositores para empresas, peças personalizadas, miniaturas e decoração.",
  url: SITE_URL,
  logo: `${SITE_URL}assets/logo.png`,
  image: og,
  telephone: TELEFONE,
  address: { "@type": "PostalAddress", addressLocality: "Goiânia", addressRegion: "GO", addressCountry: "BR" },
  areaServed: [{ "@type": "City", name: "Goiânia" }, { "@type": "Country", name: "Brasil" }],
  founder: [{ "@type": "Person", name: "Júnior" }, { "@type": "Person", name: "Thairine" }],
  sameAs: [LINKS.contato.instagram, LINKS.hub.shopee, LINKS.catalogo.site]
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{titulo}</title>
  <meta name="description" content={descricao}>
  <meta name="theme-color" content="#0A0A0B">
  {semIndice ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonica}>}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Nosso Projeto 3D">
  <meta property="og:url" content={canonica}>
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descricao}>
  <meta property="og:image" content={og}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Logo NP dourado ao lado da frase: Ideias que ganham forma, camada por camada.">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={url("assets/icons/favicon.ico")} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={url("assets/icons/favicon-32.png")}>
  <link rel="apple-touch-icon" href={url("assets/icons/apple-touch-icon.png")}>
  <link rel="manifest" href={url("manifest.webmanifest")}>
  <meta name="apple-mobile-web-app-title" content="Projeto 3D">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
  <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
  <script is:inline src={url("assets/medicao.js")} defer></script>
</head>
<body data-medir-secoes>
  <a href="#topo" class="pular">Pular para o conteúdo</a>
  <Icones />

  <Menu />

  <main id="topo" tabindex="-1">
    <slot />
  </main>

  <Rodape />
  <script>
    // [data-inclinar]: inclina em 3D seguindo o mouse; só com mouse de verdade e sem "reduzir movimento"
    if (matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)").matches) {
      document.querySelectorAll<HTMLElement>("[data-inclinar]").forEach((el) => {
        el.addEventListener("pointermove", (e) => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          el.classList.add("inclinando");
          el.style.setProperty("--ry", `${(x - 0.5) * 10}deg`);
          el.style.setProperty("--rx", `${(0.5 - y) * 8}deg`);
          el.style.setProperty("--gx", `${x * 100}%`);
          el.style.setProperty("--gy", `${y * 100}%`);
        });
        el.addEventListener("pointerleave", () => {
          el.classList.remove("inclinando");
          el.style.setProperty("--rx", "0deg");
          el.style.setProperty("--ry", "0deg");
        });
      });
    }
  </script>
</body>
</html>

